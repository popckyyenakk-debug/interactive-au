"html = r''' Interactive AU :root{--pink:#f5b8cb;--pink2:#ffe4ed;--ink:#25212a;--muted:#8b8490;--paper:#fffafd;--line:#eee4ea} *{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#fce8ef,#e9e5f4);font-family:Arial,sans-serif;color:var(--ink);min-height:100vh;display:grid;place-items:center;padding:18px} button,input,textarea{font:inherit}button{cursor:pointer} .phone{width:min(390px,100%);height:min(820px,calc(100vh - 36px));min-height:620px;background:#17151b;border:8px solid #24212a;border-radius:42px;padding:9px;box-shadow:0 22px 60px #4b344455;position:relative;overflow:hidden} .screen{height:100%;background:#fff;border-radius:30px;overflow:hidden;position:relative;display:flex;flex-direction:column} .status{height:31px;padding:8px 18px 3px;display:flex;justify-content:space-between;font-size:11px;font-weight:bold;background:#fff} .dynamic{height:13px;width:90px;background:#17151b;border-radius:20px;position:absolute;top:8px;left:50%;transform:translateX(-50%)} .header{padding:12px 17px 13px;background:linear-gradient(120deg,#fff0f5,#f7f1ff);border-bottom:1px solid var(--line)} .header small{color:var(--muted);font-size:10px;letter-spacing:1.5px;text-transform:uppercase} .header h1{font-size:20px;margin:5px 0 2px}.header p{font-size:11px;color:var(--muted);margin:0} .content{flex:1;overflow:auto;background:#fffafd;padding:15px} .home-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px 10px;padding:15px 4px} .app{border:0;background:none;display:flex;align-items:center;flex-direction:column;gap:6px;color:#302a33;font-size:11px} .app-icon{width:57px;height:57px;border-radius:17px;display:grid;place-items:center;font-size:25px;box-shadow:0 5px 12px #33223318} .whatsapp{background:#d8f6df}.instagram{background:linear-gradient(140deg,#ffd2df,#e8d7ff)}.photos{background:#fff0bf}.notes{background:#fff2a8}.safari{background:#d6edff}.phoneapp{background:#d8f6df}.settings{background:#e9e6ed}.editor{background:#f9d9e6} .widget{background:line